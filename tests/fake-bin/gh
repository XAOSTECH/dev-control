#!/usr/bin/env bash
#
# Minimal `gh` stub for dc-key tests. Emulates the GitHub side: records secret
# writes to $GH_FAKE_SECRETS (value from stdin, never echoed) and returns dummy
# repo metadata. No network, no real account.
#
# SPDX-Licence-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2025-2026 xaoscience
set -euo pipefail

sub="${1:-}"; shift || true

case "$sub" in
    auth)
        exit 0 ;;                       # `gh auth status`
    workflow)
        # Simulate no keygen.yml on the dummy repo so tests exercise the local fallback path.
        exit 1 ;;
    repo)
        field=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) field="$2"; shift 2 ;;
                --jq)   shift 2 ;;
                *)      shift ;;
            esac
        done
        case "$field" in
            name)          echo "dummyrepo" ;;
            owner)         echo "dummyorg" ;;
            nameWithOwner) echo "dummyorg/dummyrepo" ;;
            *)             echo "" ;;
        esac ;;
    secret)
        action="${1:-}"; shift || true
        case "$action" in
            set)
                name="${1:-}"; shift || true
                # consume all flags (--org, --repo, --env, --visibility, etc.) silently
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --org|--repo|--env|--visibility) shift 2 2>/dev/null || shift ;;
                        *) shift ;;
                    esac
                done
                mkdir -p "${GH_FAKE_SECRETS:?GH_FAKE_SECRETS unset}"
                cat > "$GH_FAKE_SECRETS/$name" ;;   # value consumed from stdin, never printed
            list)
                # consume all flags silently
                while [[ $# -gt 0 ]]; do shift; done
                mkdir -p "${GH_FAKE_SECRETS:?GH_FAKE_SECRETS unset}"
                for f in "$GH_FAKE_SECRETS"/*; do
                    [[ -e "$f" ]] && printf '%s\tUpdated 2026-01-01T00:00:00Z\n' "$(basename "$f")"
                done ;;
        esac ;;
    api)
        endpoint="${1:-}"; shift || true
        method="GET"
        jq_filter="."
        fields=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --method)  method="$2"; shift 2 ;;
                --jq)      jq_filter="$2"; shift 2 ;;
                -f)        fields+=("$2"); shift 2 ;;
                *)         shift ;;
            esac
        done
        case "$endpoint" in
            /user/gpg_keys)
                if [[ "$method" == "POST" ]]; then
                    echo '42'
                else
                    echo '[]'
                fi ;;
            *) echo '{}' ;;
        esac ;;
    *)
        exit 0 ;;
esac
