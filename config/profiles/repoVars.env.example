# Dev-Control Global Repository Variables (EXAMPLE)
# ---------------------------------------------------
# Copy this file to repoVars.env and customize with your bot credentials.
#
# PRECEDENCE:
#   1. Repository-specific git config (dc-init.* in .git/config)
#   2. Global config file (config/profiles/repoVars.env when --defaults flag is used)
#   3. Interactive prompts (when neither is available)
#
# USAGE:
#   cp config/profiles/repoVars.env.example config/profiles/repoVars.env
#   # Edit repoVars.env with your values
#   dc init --defaults
#
# SECURITY:
#   - repoVars.env is gitignored by default (this .example file is tracked)
#   - Values here are SECRET NAME references (e.g., XB_UT), not actual tokens
#   - Actual secrets are stored in GitHub repository/organization settings
#
# CONFIGURATION:

# Repo config
REPO_OWNER="owner"
LICENSE_TYPE="MIT"
STABILITY="experimental"
STABILITY_COLOR="orange"

# ORG DETAILS (members used for repo owner guard in batch update)
MEMBERS="member1","member2"

# Bot Identity (for GitHub Actions bot commits/PRs)
BOT_NAME="my-bot"
BOT_EMAIL="12345+my-bot@users.noreply.github.com"

# GitHub App Credentials (secret names in repository settings)
BOT_APP_ID_SECRET="MY_BOT_APP_ID"
BOT_PRIVATE_KEY_SECRET="MY_BOT_PRIVATE_KEY"

# GPG Signing (secret names for bot commit signing)
GPG_PRIVATE_KEY_SECRET="MY_GPG_KEY"
GPG_PASSPHRASE_SECRET="MY_GPG_PASSPHRASE"

# GitHub Tokens (secret names for API access)
USER_TOKEN_SECRET="MY_GITHUB_TOKEN"

# Optional: actual PAT value for the bot account with write:gpg_key scope. Used by dc key --bot to register the new GPG public key to the bot's GitHub account locally (sandboxed via GH_TOKEN= prefix; your own gh auth is never touched). If left empty, dc key will prompt once or skip and let the identity action handle registration at the next workflow run. Never a secret name — this is the real token value, which is why repoVars.env is gitignored. Do NOT commit a value here.
BOT_TOKEN=""

# Security App Credentials (for automerge/security workflows)
SECURITY_APP_ID_SECRET="SECURITY_APP_ID"
SECURITY_PRIVATE_KEY_SECRET="SECURITY_PRIVATE_KEY"